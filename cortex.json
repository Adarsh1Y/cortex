{
  "data_dir": "~/.consciousness",
  "brain": {
    "engine": "opencode",
    "model": "inherit"
  },
  "memory": {
    "episodic": true,
    "semantic": true,
    "recall_on_start": true,
    "max_context_turns": 20
  },
  "proactive": {
    "enabled": true,
    "idle_minutes": 10,
    "cooldown_minutes": 30
  },
  "web": {
    "enabled": false,
    "port": 4040
  },
  "shell": {
    "prompt": "you > ",
    "welcome_message": true,
    "colors": true
  }
}
